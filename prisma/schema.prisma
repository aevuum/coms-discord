generator client {
  provider = "prisma-client"
  output   = "../src/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CharacterFaculty {
  GRYFFINDOR
  SLYTHERIN
  HUFFLEPUFF
  RAVENCLAW
  ADULT
}

enum AwardRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum CharacterStatus {
  ALIVE
  DEAD
  FROZEN
}

enum TransactionType {
  TRANSFER_IN
  TRANSFER_OUT
  SALARY
  PURCHASE
  FINE
  ADMIN_ADD
  ADMIN_REMOVE
}

model User {
  id        String @id @default(cuid())
  discordId String @unique
  // level     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messagesCount Int @default(0)

  characterSlots Int @default(0)

  weeklyMessages     Int @default(0)
  weeklyVoiceSeconds Int @default(0)
  voiceSeconds  Int @default(0)

  selectedAwardId String?
  awards          UserAward[]

  profileBannerUrl  String?
  profileBannerPath String?

  wallet   Wallet @relation(fields: [walletId], references: [id])
  walletId String @unique

  inventory InventoryItem[]

  coinTransactions CoinTransaction[]

  characters Character[]
}

model Award {
  id String @id @default(cuid())

  label String
  emoji String

  description String

  rewardComsCoins Int @default(0)

  rarity AwardRarity @default(COMMON)

  createdAt DateTime @default(now())

  users UserAward[]
}

model UserAward {
  id String @id @default(cuid())

  userId  String
  awardId String

  issuedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  award Award @relation(fields: [awardId], references: [id])

  @@unique([userId, awardId], name: "userId_awardId")
}

model Wallet {
  id String @id @default(cuid())

  comsCoins Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User?
}

model Character {
  id String @id @default(cuid())

  tupper CharacterTupper?

  rpName     String
  avatarUrl  String?
  avatarPath String?
  faculty   CharacterFaculty

  status CharacterStatus @default(ALIVE)

  balanceKnuts Int

  age Int?

  mana          Int      @default(100)
  maxMana       Int      @default(100)
  manaUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions   CharacterTransaction[]
  inventoryItems CharacterInventoryItem[]
  spellCasts     SpellCast[]

  @@index([userId])
}

enum SpellDifficulty {
  BASIC
  INTERMEDIATE
  ADVANCED
  MASTER
  UNFORGIVABLE
}

model Spell {
  id String @id @default(cuid())

  name         String
  incantations String[]
  description  String?

  difficulty SpellDifficulty @default(BASIC)
  manaCost   Int?

  imageUrl     String?
  gifQuery     String?
  gifUrls      String[]
  gifFetchedAt DateTime?

  isCustom Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  casts SpellCast[]
}

model SpellCast {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  spellId   String?
  spell     Spell?  @relation(fields: [spellId], references: [id], onDelete: SetNull)
  spellName String

  manaCost  Int
  manaAfter Int

  channelId String
  messageId String?

  createdAt DateTime @default(now())

  @@index([characterId, createdAt])
}

model CharacterTransaction {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  type TransactionType

  amountKnuts Int

  balanceAfterKnuts Int

  reason String?

  createdAt DateTime @default(now())

  @@index([characterId, createdAt])
}

enum ShopCurrency {
  COMS_COINS
  KNUTS
}

model ShopItem {
  id String @id @default(cuid())

  name        String
  description String?
  emoji       String?
  iconUrl     String?

  price    Int
  currency ShopCurrency @default(COMS_COINS)

  category String  @default("general")
  isActive Boolean @default(true)

  maxPerUser Int?

  grantsCharacterSlot Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  playerInventory    InventoryItem[]
  characterInventory CharacterInventoryItem[]
}

model InventoryItem {
  id String @id @default(cuid())

  userId     String
  shopItemId String

  quantity Int @default(1)

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@unique([userId, shopItemId])
}

model CharacterInventoryItem {
  id String @id @default(cuid())

  characterId String
  shopItemId  String?

  name    String
  nameKey String

  imageData Bytes?
  imageMime String?
  imagePath String?

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  shopItem  ShopItem? @relation(fields: [shopItemId], references: [id], onDelete: SetNull)

  @@unique([characterId, nameKey])
  @@index([characterId])
}

model CommandPermission {
  id String @id @default(cuid())

  guildId     String
  commandName String
  roleId      String

  createdAt DateTime @default(now())

  @@unique([guildId, commandName, roleId])
  @@index([guildId])
}

model CharacterTupper {
  id String @id @default(cuid())

  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name String

  prefix String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CoinTransactionType {
  PURCHASE
  STIPEND
  ADMIN_ADD
  ADMIN_REMOVE
  AWARD_GRANT
  AWARD_REVOKE
  ACTIVITY_REWARD
}

model CoinTransaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         CoinTransactionType
  amount       Int
  balanceAfter Int
  reason       String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model RoleStipend {
  id String @id @default(cuid())

  guildId String
  roleId  String
  amount  Int

  lastPaidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, roleId])
}

enum TicketStatus {
  OPEN
  CLOSED
}

model Ticket {
  id String @id @default(cuid())

  guildId   String
  channelId String @unique
  ownerId   String

  staffMessageId String?
  reviewerId     String?

  tagId   String
  subject String

  paidSlot Boolean @default(false)

  status TicketStatus @default(OPEN)

  lastCalledAt DateTime?
  closedById   String?
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, tagId, status])
}

enum LocationAccess {
  OPEN
  APPROVAL
}

enum TravelStatus {
  PENDING
  TRAVELING
}

model Location {
  id String @id @default(cuid())

  guildId String
  roleId  String

  name        String
  emoji       String?
  description String?

  access           LocationAccess @default(OPEN)
  arrivalChannelId String?
  sortOrder        Int            @default(0)

  routesFrom LocationRoute[] @relation("RouteFrom")
  routesTo   LocationRoute[] @relation("RouteTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, roleId])
}

model LocationRoute {
  id String @id @default(cuid())

  fromId String
  from   Location @relation("RouteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Location @relation("RouteTo", fields: [toId], references: [id], onDelete: Cascade)

  method        String
  travelMinutes Int     @default(0)
  itemName      String?
  itemKey       String?
  itemQuantity  Int     @default(1)
  adultOnly     Boolean @default(false)
  magical       Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([fromId])
}

model Travel {
  id String @id @default(cuid())

  guildId String
  userId  String @unique

  fromId  String?
  toId    String
  routeId String

  status    TravelStatus
  arrivesAt DateTime?

  requestMessageId String?

  createdAt DateTime @default(now())
}

model LocationSettings {
  guildId String @id

  requestChannelId String?
  logChannelId     String?
  guideChannelId   String?
  travelRoleId     String?

  updatedAt DateTime @updatedAt
}

enum RollKind {
  RACE
  TRAIT
}

model RollEntry {
  id String @id @default(cuid())

  kind RollKind

  name        String
  description String?
  emoji       String?
  imageUrl    String?

  chance    Int     @default(0)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model ActivitySettings {
  guildId String @id

  rewardFirst  Int @default(0)
  rewardSecond Int @default(0)
  rewardThird  Int @default(0)

  lastResetAt DateTime?

  updatedAt DateTime @updatedAt
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

model Report {
  id String @id @default(cuid())

  guildId    String
  reporterId String
  targetId   String

  reason      String?
  description String

  channelId      String?
  messageId      String?
  messageContent String?

  images String[] @default([])

  staffMessageId String?
  reviewerId     String?

  status ReportStatus @default(OPEN)

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetId])
}

enum StaffApplicationStatus {
  DRAFT
  AWAITING_POST
  PENDING
  ACCEPTED
  REJECTED
}

model StaffApplication {
  id String @id @default(cuid())

  guildId String
  userId  String

  tagId    String
  roleName String
  roleId   String?

  answers Json

  trialPrompt String?
  trialPost   String?

  staffMessageId String?
  threadId       String?

  status StaffApplicationStatus @default(DRAFT)

  decidedById  String?
  decidedAt    DateTime?
  rejectReason String?

  votes StaffApplicationVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, tagId, status])
}

model StaffApplicationVote {
  applicationId String
  userId        String
  stars         Int

  application StaffApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([applicationId, userId])
}
