generator client {
  provider = "prisma-client"
  output   = "../src/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CharacterFaculty {
  GRYFFINDOR
  SLYTHERIN
  HUFFLEPUFF
  RAVENCLAW
  ADULT
}

enum AwardRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum CharacterStatus {
  ALIVE
  DEAD
  FROZEN
}

enum TransactionType {
  TRANSFER_IN
  TRANSFER_OUT
  SALARY
  PURCHASE
  FINE
  ADMIN_ADD
  ADMIN_REMOVE
}

model User {
  id        String @id @default(cuid())
  discordId String @unique
  // level     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messagesCount Int @default(0)
  voiceSeconds  Int @default(0)

  selectedAwardId String?
  awards          UserAward[]

  profileBannerUrl String?

  wallet   Wallet @relation(fields: [walletId], references: [id])
  walletId String @unique

  inventory InventoryItem[]

  characters Character[]
}

model Award {
  id String @id @default(cuid())

  label String
  emoji String

  description String

  rewardComsCoins Int @default(0)

  rarity AwardRarity @default(COMMON)

  createdAt DateTime @default(now())

  users UserAward[]
}

model UserAward {
  id String @id @default(cuid())

  userId  String
  awardId String

  issuedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  award Award @relation(fields: [awardId], references: [id])

  @@unique([userId, awardId], name: "userId_awardId")
}

model Wallet {
  id String @id @default(cuid())

  comsCoins Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User?
}

model Character {
  id String @id @default(cuid())

  rpName    String
  avatarUrl String?
  faculty   CharacterFaculty

  status CharacterStatus @default(ALIVE)

  balanceKnuts Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions   CharacterTransaction[]
  inventoryItems CharacterInventoryItem[]

  @@index([userId])
}

model CharacterTransaction {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  type TransactionType

  amountKnuts Int

  balanceAfterKnuts Int

  reason String?

  createdAt DateTime @default(now())

  @@index([characterId, createdAt])
}

model ShopItem {
  id String @id @default(cuid())

  name        String
  description String?
  iconUrl     String?

  priceKnuts Int

  category String  @default("general")
  isActive Boolean @default(true)

  maxPerUser Int?

  createdAt DateTime @default(now())

  playerInventory    InventoryItem[]
  characterInventory CharacterInventoryItem[]
}

model InventoryItem {
  id String @id @default(cuid())

  userId     String
  shopItemId String

  quantity Int @default(1)

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id])

  @@unique([userId, shopItemId])
}

model CharacterInventoryItem {
  id String @id @default(cuid())

  characterId String
  shopItemId  String

  quantity Int @default(1)

  createdAt DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  shopItem  ShopItem  @relation(fields: [shopItemId], references: [id])

  @@unique([characterId, shopItemId])
}
