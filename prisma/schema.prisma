generator client {
  provider = "prisma-client"
  output   = "../src/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CharacterFaculty {
  GRYFFINDOR
  SLYTHERIN
  HUFFLEPUFF
  RAVENCLAW
  ADULT
}

enum AwardRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum CharacterStatus {
  ALIVE
  DEAD
  FROZEN
}

enum TransactionType {
  TRANSFER_IN
  TRANSFER_OUT
  SALARY
  PURCHASE
  FINE
  ADMIN_ADD
  ADMIN_REMOVE
}

model User {
  id        String @id @default(cuid())
  discordId String @unique
  // level     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messagesCount Int @default(0)

  characterSlots Int @default(0)

  weeklyMessages     Int @default(0)
  weeklyVoiceSeconds Int @default(0)
  voiceSeconds  Int @default(0)

  selectedAwardId String?
  awards          UserAward[]

  profileBannerUrl  String?
  profileBannerPath String?

  wallet   Wallet @relation(fields: [walletId], references: [id])
  walletId String @unique

  inventory InventoryItem[]

  coinTransactions CoinTransaction[]

  characters Character[]
}

model Award {
  id String @id @default(cuid())

  label String
  emoji String

  description String

  rewardComsCoins Int @default(0)

  rarity AwardRarity @default(COMMON)

  createdAt DateTime @default(now())

  users UserAward[]
}

model UserAward {
  id String @id @default(cuid())

  userId  String
  awardId String

  issuedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  award Award @relation(fields: [awardId], references: [id])

  @@unique([userId, awardId], name: "userId_awardId")
}

model Wallet {
  id String @id @default(cuid())

  comsCoins Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User?
}

model Character {
  id String @id @default(cuid())

  tupper   CharacterTupper?
  familiar CharacterFamiliar?
  runes    CharacterRune[]
  runeStudyRequests RuneStudyRequest[]
  runeFormulas      SpellFormula[]
  artifacts         Artifact[]
  runeOperations    RuneOperation[]
  runeAudit         RuneAuditLog[]

  rpName     String
  avatarUrl  String?
  avatarPath String?
  faculty   CharacterFaculty

  status CharacterStatus @default(ALIVE)

  balanceKnuts Int

  age Int?

  specialRole String?

  traitId String?
  trait   RollEntry? @relation(fields: [traitId], references: [id], onDelete: SetNull)

  mana          Int      @default(100)
  maxMana       Int      @default(100)
  manaUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions   CharacterTransaction[]
  inventoryItems CharacterInventoryItem[]
  spellCasts     SpellCast[]

  @@index([userId])
}

enum SpellDifficulty {
  BASIC
  INTERMEDIATE
  ADVANCED
  MASTER
  UNFORGIVABLE
}

model Spell {
  id String @id @default(cuid())

  name         String
  incantations String[]
  description  String?

  difficulty SpellDifficulty @default(BASIC)
  manaCost   Int?

  imageUrl     String?
  imagePath    String?
  gifQuery     String?
  gifUrls      String[]
  gifPaths     String[]
  gifFetchedAt DateTime?

  isCustom Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  casts SpellCast[]
  formulas SpellFormula[]
}

model SpellCast {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  spellId   String?
  spell     Spell?  @relation(fields: [spellId], references: [id], onDelete: SetNull)
  spellName String

  manaCost  Int
  manaAfter Int

  channelId String
  messageId String?

  createdAt DateTime @default(now())

  @@index([characterId, createdAt])
}

model CharacterTransaction {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  type TransactionType

  amountKnuts Int

  balanceAfterKnuts Int

  reason String?

  createdAt DateTime @default(now())

  @@index([characterId, createdAt])
}

enum ShopCurrency {
  COMS_COINS
  KNUTS
}

model ShopItem {
  id String @id @default(cuid())

  name        String
  description String?
  emoji       String?
  iconUrl     String?

  price    Int
  currency ShopCurrency @default(COMS_COINS)

  category String  @default("general")
  isActive Boolean @default(true)

  maxPerUser Int?

  grantsCharacterSlot Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  playerInventory    InventoryItem[]
  characterInventory CharacterInventoryItem[]
}

model InventoryItem {
  id String @id @default(cuid())

  userId     String
  shopItemId String

  quantity Int @default(1)

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@unique([userId, shopItemId])
}

model CharacterInventoryItem {
  id String @id @default(cuid())

  characterId String
  shopItemId  String?

  name    String
  nameKey String

  imageData Bytes?
  imageMime String?
  imagePath String?

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  shopItem  ShopItem? @relation(fields: [shopItemId], references: [id], onDelete: SetNull)

  @@unique([characterId, nameKey])
  @@index([characterId])
}

model CommandPermission {
  id String @id @default(cuid())

  guildId     String
  commandName String
  roleId      String

  createdAt DateTime @default(now())

  @@unique([guildId, commandName, roleId])
  @@index([guildId])
}


model CharacterFamiliar {
  id String @id @default(cuid())

  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name        String
  description String
  imagePath   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterTupper {
  id String @id @default(cuid())

  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name String

  prefix String @unique

  lastChannelId String?
  lastUsedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastChannelId])
}

enum CoinTransactionType {
  PURCHASE
  STIPEND
  ADMIN_ADD
  ADMIN_REMOVE
  AWARD_GRANT
  AWARD_REVOKE
  ACTIVITY_REWARD
}

model CoinTransaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         CoinTransactionType
  amount       Int
  balanceAfter Int
  reason       String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model RoleStipend {
  id String @id @default(cuid())

  guildId String
  roleId  String
  amount  Int

  lastPaidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, roleId])
}

enum TicketStatus {
  OPEN
  CLOSED
}

model Ticket {
  id String @id @default(cuid())

  guildId   String
  channelId String @unique
  ownerId   String

  staffMessageId String?
  reviewerId     String?

  tagId   String
  subject String

  paidSlot Boolean @default(false)

  status TicketStatus @default(OPEN)

  lastCalledAt DateTime?
  closedById   String?
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, tagId, status])
}

enum LocationAccess {
  OPEN
  APPROVAL
}

enum TravelStatus {
  PENDING
  TRAVELING
}

model Location {
  id String @id @default(cuid())

  guildId String
  roleId  String

  name        String
  emoji       String?
  description String?

  access           LocationAccess @default(OPEN)
  arrivalChannelId String?
  sortOrder        Int            @default(0)

  routesFrom LocationRoute[] @relation("RouteFrom")
  routesTo   LocationRoute[] @relation("RouteTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, roleId])
}

model LocationRoute {
  id String @id @default(cuid())

  fromId String
  from   Location @relation("RouteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Location @relation("RouteTo", fields: [toId], references: [id], onDelete: Cascade)

  method        String
  travelMinutes Int     @default(0)
  itemName      String?
  itemKey       String?
  itemQuantity  Int     @default(1)
  adultOnly     Boolean @default(false)
  magical       Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([fromId])
}

model Travel {
  id String @id @default(cuid())

  guildId String
  userId  String @unique

  fromId  String?
  toId    String
  routeId String

  status    TravelStatus
  arrivesAt DateTime?

  requestMessageId String?

  createdAt DateTime @default(now())
}

model LocationSettings {
  guildId String @id

  requestChannelId String?
  logChannelId     String?
  guideChannelId   String?
  travelRoleId     String?

  updatedAt DateTime @updatedAt
}

enum RollKind {
  RACE
  TRAIT
}

model RollEntry {
  id String @id @default(cuid())

  kind RollKind

  name        String
  description String?
  emoji       String?
  imageUrl    String?
  imagePath   String?

  chance    Int     @default(0)
  isDefault Boolean @default(false)

  characters Character[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model ActivitySettings {
  guildId String @id

  rewardFirst  Int @default(0)
  rewardSecond Int @default(0)
  rewardThird  Int @default(0)

  lastResetAt DateTime?

  updatedAt DateTime @updatedAt
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

model Report {
  id String @id @default(cuid())

  guildId    String
  reporterId String
  targetId   String

  reason      String?
  description String

  channelId      String?
  messageId      String?
  messageContent String?

  images String[] @default([])

  targetIsStaff Boolean @default(false)

  staffMessageId String?
  reviewerId     String?

  status ReportStatus @default(OPEN)

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetId])
}

enum StaffApplicationStatus {
  DRAFT
  AWAITING_POST
  PENDING
  ACCEPTED
  REJECTED
}

model StaffApplication {
  id String @id @default(cuid())

  guildId String
  userId  String

  tagId    String
  roleName String
  roleId   String?

  answers Json

  trialPrompt String?
  trialPost   String?

  staffMessageId String?
  threadId       String?

  status StaffApplicationStatus @default(DRAFT)

  decidedById  String?
  decidedAt    DateTime?
  rejectReason String?

  votes StaffApplicationVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, tagId, status])
}

model StaffApplicationVote {
  applicationId String
  userId        String
  stars         Int

  application StaffApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([applicationId, userId])
}

model StaffApplicationRole {
  tagId String @id

  roleId    String?
  open      Boolean @default(true)
  questions Json?

  updatedAt DateTime @updatedAt
}

model ReportSettings {
  guildId String @id

  reviewerRoleIds String[] @default([])

  updatedAt DateTime @updatedAt
}

enum GiveawayStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model Giveaway {
  id String @id @default(cuid())

  guildId   String
  channelId String
  messageId String?
  hostId    String

  prize       String
  description String?
  imagePath   String?

  winnerCount Int
  winnerIds   String[] @default([])

  status  GiveawayStatus @default(ACTIVE)
  endsAt  DateTime
  endedAt DateTime?

  entries GiveawayEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endsAt])
}

model GiveawayEntry {
  giveawayId String
  userId     String

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([giveawayId, userId])
}

model GiveawaySettings {
  guildId String @id

  channelId  String?
  pingRoleId String?

  updatedAt DateTime @updatedAt
}

model TermsAcceptance {
  discordId String @id

  version    String
  acceptedAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Suggestion {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  guildId  String
  authorId String

  title       String
  category    String
  description String
  benefit     String?

  messageId  String?
  threadId   String?
  pingRoleId String?

  status      SuggestionStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  reason      String?

  reactions SuggestionReaction[]
  ratings   SuggestionRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, createdAt])
}

model SuggestionReaction {
  suggestionId String
  userId       String
  value        Int

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([suggestionId, userId])
}

model SuggestionRating {
  suggestionId String
  userId       String
  stars        Int

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([suggestionId, userId])
}

model PingRole {
  roleId String @id

  guildId     String
  label       String
  emoji       String?
  description String?
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, sortOrder])
}

model ProphetState {
  guildId String @id

  lastIssueId    String?
  deliveredAt    DateTime?
  deliveredCount Int       @default(0)

  updatedAt DateTime @updatedAt
}

model PendingTraitRoll {
  discordId   String @id
  rollEntryId String

  rolledAt DateTime @default(now())
}

enum RuneFuthark {
  ELDER
  YOUNGER
}

enum RuneDesignStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum RuneRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RuneOutcome {
  REFUSE
  FIZZLE
  BACKFIRE
  INJURY
  MATERIALS_LOST
  DAMAGED
  UNSTABLE
  DESTROYED
}

enum ArtifactStatus {
  ACTIVE
  UNSTABLE
  DAMAGED
  DESTROYED
}

enum RuneOperationKind {
  FORMULA_CAST
  ARTIFACT_CRAFT
}

enum RuneOperationStatus {
  PENDING
  DONE
  CANCELLED
}

enum RuneAuditAction {
  RUNE_UPDATED
  RUNE_LEARNED
  RUNE_FORGOTTEN
  MASTERY_CHANGED
  STUDY_REQUESTED
  STUDY_REJECTED
  FORMULA_PROPOSED
  FORMULA_CREATED
  FORMULA_UPDATED
  FORMULA_APPROVED
  FORMULA_REJECTED
  FORMULA_DISABLED
  FORMULA_ATTEMPTED
  FORMULA_REVIEWED
  RECIPE_CREATED
  RECIPE_UPDATED
  RECIPE_APPROVED
  RECIPE_REJECTED
  RECIPE_DISABLED
  ARTIFACT_CRAFTED
  MATERIAL_CHANGED
  BLANK_CHANGED
  SETTINGS_UPDATED
}

model Rune {
  key       String      @id
  futhark   RuneFuthark
  name      String
  emoji     String
  sortOrder Int         @default(0)

  meaning      String
  domain       String?
  principle    String?
  modifies     String?
  spellUse     String?
  artifactUse  String?
  restrictions String?
  load         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters    CharacterRune[]
  studyRequests RuneStudyRequest[]
  formulas      SpellFormula[]
  recipeRunes   ArtifactRecipeRune[]
  artifactRunes ArtifactRune[]

  @@index([futhark, sortOrder])
}

model CharacterRune {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  runeKey String
  rune    Rune   @relation(fields: [runeKey], references: [key], onDelete: Cascade)

  mastery       Int      @default(0)
  learnedAt     DateTime @default(now())
  confirmedById String

  updatedAt DateTime @updatedAt

  @@unique([characterId, runeKey])
}

model RuneStudyRequest {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  runeKey String
  rune    Rune   @relation(fields: [runeKey], references: [key], onDelete: Cascade)

  postUrl String
  note    String?

  status     RuneRequestStatus @default(PENDING)
  reviewerId String?
  reason     String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([characterId])
}

model SpellFormula {
  id String @id @default(cuid())

  spellId String
  spell   Spell  @relation(fields: [spellId], references: [id], onDelete: Cascade)

  runeKey String
  rune    Rune   @relation(fields: [runeKey], references: [key], onDelete: Cascade)

  incantation    String
  incantationKey String @unique
  effect         String
  mechanics      String?
  restrictions   String?

  minMastery     Int         @default(0)
  baseRisk       Int         @default(15)
  complexity     Int         @default(0)
  failureOutcome RuneOutcome @default(FIZZLE)

  status RuneDesignStatus @default(PENDING)

  authorId          String
  authorCharacterId String?
  authorCharacter   Character? @relation(fields: [authorCharacterId], references: [id], onDelete: SetNull)

  reviewerId   String?
  reviewReason String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations RuneOperation[]

  @@index([status])
  @@index([runeKey])
  @@index([spellId])
}

model ArtifactMaterial {
  id String @id @default(cuid())

  name          String  @unique
  description   String?
  capacityBonus Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes ArtifactRecipeMaterial[]
}

model ArtifactBlank {
  id String @id @default(cuid())

  name           String  @unique
  kind           String?
  description    String?
  baseCapacity   Int
  qualityPercent Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes ArtifactRecipe[]
}

model ArtifactRecipe {
  id String @id @default(cuid())

  name        String
  effect      String
  description String?

  blankId String
  blank   ArtifactBlank @relation(fields: [blankId], references: [id], onDelete: Restrict)

  minMastery      Int         @default(0)
  baseRisk        Int         @default(15)
  complexity      Int         @default(0)
  overloadOutcome RuneOutcome @default(REFUSE)
  failureOutcome  RuneOutcome @default(MATERIALS_LOST)

  status RuneDesignStatus @default(PENDING)

  authorId     String
  reviewerId   String?
  reviewReason String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runes      ArtifactRecipeRune[]
  materials  ArtifactRecipeMaterial[]
  artifacts  Artifact[]
  operations RuneOperation[]

  @@index([status])
}

model ArtifactRecipeRune {
  recipeId String
  recipe   ArtifactRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  runeKey String
  rune    Rune   @relation(fields: [runeKey], references: [key], onDelete: Restrict)

  critical Boolean @default(false)

  @@id([recipeId, runeKey])
}

model ArtifactRecipeMaterial {
  recipeId String
  recipe   ArtifactRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  materialId String
  material   ArtifactMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  @@id([recipeId, materialId])
}

model Artifact {
  id String @id @default(cuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  recipeId String?
  recipe   ArtifactRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  operationId String? @unique

  name     String
  effect   String
  status   ArtifactStatus @default(ACTIVE)
  capacity Int
  load     Int
  quality  Int

  createdAt DateTime @default(now())

  runes ArtifactRune[]

  @@index([characterId])
}

model ArtifactRune {
  artifactId String
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  runeKey String
  rune    Rune   @relation(fields: [runeKey], references: [key], onDelete: Restrict)

  load     Int
  critical Boolean @default(false)

  @@id([artifactId, runeKey])
}

model RuneOperation {
  id String @id @default(cuid())

  kind   RuneOperationKind
  status RuneOperationStatus @default(PENDING)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  actorId String

  formulaId String?
  formula   SpellFormula? @relation(fields: [formulaId], references: [id], onDelete: SetNull)

  recipeId String?
  recipe   ArtifactRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  extraMaterialIds String[]

  postUrl    String?
  note       String?
  reviewerId String?
  verdict    String?

  risk    Int
  roll    Int?
  success Boolean?
  outcome RuneOutcome?
  quality Int?
  details Json?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([kind, status])
  @@index([characterId, createdAt])
}

model RuneAuditLog {
  id String @id @default(cuid())

  action  RuneAuditAction
  actorId String

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  runeKey   String?
  formulaId String?
  recipeId  String?

  fromValue Int?
  toValue   Int?
  note      String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([characterId, createdAt])
}

model RuneSettings {
  id String @id @default("global")

  elderLoad             Int @default(3)
  youngerLoad           Int @default(2)
  masteryReductionPct   Int @default(40)
  minRisk               Int @default(1)
  maxRisk               Int @default(95)
  defaultBaseRisk       Int @default(15)
  defaultInitialMastery Int @default(5)

  updatedAt DateTime @updatedAt
}
