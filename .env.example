# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# ID of the Discord server the bot works on
GUILD_ID=

# Comma-separated role IDs allowed to roll/reroll races
RACE_ALLOWED_ROLE_IDS=

# PostgreSQL credentials, used by docker-compose to create the database
# Generate a strong password, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_USER=comsbot
POSTGRES_PASSWORD=
POSTGRES_DB=comsbot

# PostgreSQL connection string for running the bot or Prisma CLI outside Docker.
# Must use the same credentials as above. Inside docker-compose it is built automatically.
DATABASE_URL=postgresql://comsbot:<POSTGRES_PASSWORD>@localhost:5432/comsbot
