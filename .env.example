# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# ID of the Discord server the bot works on
GUILD_ID=

# Comma-separated role IDs allowed to roll/reroll races
RACE_ALLOWED_ROLE_IDS=

# PostgreSQL connection string (used by the bot and Prisma CLI).
# In docker-compose this is overridden to point at the postgres service.
DATABASE_URL=postgresql://comsbot:comsbot_password@localhost:5432/comsbot
